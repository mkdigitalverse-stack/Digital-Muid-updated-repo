<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # -------------------------------------------------------------
  # 1. Canonical Domain (Force HTTPS and non-WWW)
  # -------------------------------------------------------------
  RewriteCond %{HTTP_HOST} ^www\.digitalmuid\.in$ [NC]
  RewriteRule ^(.*)$ https://digitalmuid.in/$1 [R=301,L]

  # -------------------------------------------------------------
  # 2. Trailing Slash Normalization (Remove trailing slash on non-dir)
  # -------------------------------------------------------------
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteCond %{REQUEST_URI} ^(.+)/$
  RewriteRule ^(.+)/$ /$1 [R=301,L]

  # -------------------------------------------------------------
  # 3. Route Canonicalization Aliases
  # -------------------------------------------------------------
  RewriteRule ^consultation/?$ /business-growth-consultation [R=301,L]
  RewriteRule ^courses/?$ /learn [R=301,L]
  RewriteRule ^web-(services|development|design)/?$ /web [R=301,L]

  # -------------------------------------------------------------
  # 4. WordPress Migration 301 Redirects & 410 Retirements
  # -------------------------------------------------------------
  # URL 1: Old Services page -> /services
  RewriteRule ^services-3/?$ /services [R=301,L]

  # URL 5: Old Social Media Marketing -> /services/modern-marketing
  RewriteRule ^services-3/social-media-marketing/?$ /services/modern-marketing [R=301,L]

  # URL 6: Old SMM Packages in Lucknow -> /services/modern-marketing
  RewriteRule ^smm-packages-in-lucknow/?$ /services/modern-marketing [R=301,L]

  # URL 3: Old Meta Ads Course -> /learn/meta-ads-mastery
  RewriteRule ^courses/complete-meta-ads-mastery-course-why-its-essential-to-start-early-in-your-career/?$ /learn/meta-ads-mastery [R=301,L]

  # URL 2: Old Pricing page -> 410 Gone
  RewriteRule ^price/?$ - [G,L]

  # URL 4: Old Terms & Conditions -> /terms
  RewriteRule ^terms-conditions/?$ /terms [R=301,L]

  # Legacy WordPress Sitemap Index & Sub-sitemaps -> 301 to /sitemap.xml
  RewriteRule ^sitemap_index\.xml/?$ https://digitalmuid.in/sitemap.xml [R=301,L]
  RewriteRule ^(page|post|category)-sitemap\.xml/?$ https://digitalmuid.in/sitemap.xml [R=301,L]

  # -------------------------------------------------------------
  # 5. Standard SPA Fallback
  # -------------------------------------------------------------
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
