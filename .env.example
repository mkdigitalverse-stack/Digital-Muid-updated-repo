# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Foundation Configuration (Step 2)
# Public URL and Anonymous Public Key for client-side queries and Supabase Auth.
# NEVER place a service_role key here.
VITE_SUPABASE_URL="https://kpuxtsworzkueyffjaaz.supabase.co"
VITE_SUPABASE_ANON_KEY="YOUR_SUPABASE_ANON_KEY"

# Razorpay Payment Gateway Configuration (Phase 2K)
# Client-safe Public Key ID for Razorpay Checkout UI
VITE_RAZORPAY_KEY_ID="rzp_test_placeholder_key"

# Server-only Razorpay Gateway Credentials
# NEVER expose Key Secret or Webhook Secret to the browser
RAZORPAY_KEY_ID="rzp_test_placeholder_key"
RAZORPAY_KEY_SECRET="your_razorpay_key_secret_here"
RAZORPAY_WEBHOOK_SECRET="your_razorpay_webhook_secret_here"

# Server-only Supabase Service Role Key
# Privileged key for server-side payment fulfillment and automated enrollment
# NEVER expose this key to the browser or in VITE_* variables
SUPABASE_SERVICE_ROLE_KEY="your_supabase_service_role_key_here"

